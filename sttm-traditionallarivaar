  let activeTooltip = null;
  let activeItem = null;
  let observer = null;

  function cleanText(str) {
    return str.replace(/\s+/g, ' ').trim();
  }

  // toUnicode comes from the inlined GurmukhiUtils module above — no network
  // request involved, so this always succeeds unless the bundle itself
  // failed to parse (in which case GurmukhiUtils.toUnicode would be undefined
  // and we fall back to raw ASCII text, same safety net as before).
  function convert(raw) {
    if (GurmukhiUtils && typeof GurmukhiUtils.toUnicode === 'function') {
      return GurmukhiUtils.toUnicode(raw);
    }
    console.warn('[gurbani-flow] GurmukhiUtils.toUnicode unavailable; copying raw ASCII instead.');
    return raw;
  }

  async function copyGurbaniLine(wrapper) {
    const gurbaniEl = wrapper.querySelector(GURBANI_DISPLAY_SEL);
    const gurlipi = gurbaniEl && gurbaniEl.querySelector('.sui-gurlipi');
    const raw = gurlipi ? cleanText(gurlipi.textContent) : '';
    await navigator.clipboard.writeText(convert(raw));
  }

  async function copyTooltipAll(wrapper) {
    const lines = Array.from(wrapper.querySelectorAll('.sui-gurbani-line'))
      .filter((el) => el.textContent.trim().length > 0);

    const parts = lines.map((line) => {
      const gurlipi = line.querySelector('.sui-gurlipi');
      if (gurlipi) {
        return convert(cleanText(gurlipi.textContent));
      }
      return cleanText(line.textContent);
    });

    await navigator.clipboard.writeText(parts.join('\n\n'));
  }

  function flashCopied(btn) {
    const original = btn.textContent;
    btn.textContent = '✓ Copied';
    setTimeout(() => {
      btn.textContent = original;
    }, 1200);
  }

  function hideTooltip() {
    if (activeTooltip) activeTooltip.remove();
    if (activeItem) activeItem.classList.remove('gurbani-flow-active');
    activeTooltip = null;
    activeItem = null;
  }

  function stripVisraamColors(root) {
    root.querySelectorAll('[class*="sui-visraam"]').forEach((el) => {
      el.className = el.className
        .split(' ')
        .filter((c) => c && !c.startsWith('sui-visraam'))
        .join(' ');
    });
  }

  function colorSpecialSymbols(root) {
    const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);
    const textNodes = [];
    let node;
    while ((node = walker.nextNode())) {
      if (node.nodeValue.includes('<>')) textNodes.push(node);
    }
    textNodes.forEach((textNode) => {
      const parts = textNode.nodeValue.split('<>');
      const frag = document.createDocumentFragment();
      parts.forEach((part, i) => {
        if (part) frag.appendChild(document.createTextNode(part));
        if (i < parts.length - 1) {
          const span = document.createElement('span');
          span.className = 'gurbani-flow-special';
          span.textContent = '<>';
          frag.appendChild(span);
        }
      });
      textNode.parentNode.replaceChild(frag, textNode);
    });
  }

  function scaleFontSize(el, factor) {
    const current = el.style.fontSize;
    const match = current && current.match(/^([\d.]+)([a-z%]+)$/i);
    if (match) {
      const value = parseFloat(match[1]) * factor;
      el.style.fontSize = value + match[2];
    }
  }

  function getJoinedWords(gurbaniEl) {
    const leafSpans = Array.from(gurbaniEl.querySelectorAll('span'))
      .filter(s => s.children.length === 0);
    return leafSpans.map(s => s.textContent.trim()).join('');
  }

  function buildExtraSections(wrapper) {
    const frag = document.createDocumentFragment();
    Array.from(wrapper.children).forEach((child) => {
      if (child.matches(GURBANI_PARAGRAPH_SEL)) return;
      if (!child.textContent.trim()) return;
      const section = document.createElement('div');
      section.className = 'tt-section';
      const clone = child.cloneNode(true);
      colorSpecialSymbols(clone);
      section.appendChild(clone);
      frag.appendChild(section);
    });
    return frag;
  }

  // Colors every distinct .sui-gurbani-line found in the extra sections
  // (transliteration, each translation, and each steek source separately),
  // cycling through a 5-color palette. Works for any future content type
  // since the site wraps every such line in .sui-gurbani-line consistently.
  function styleTooltipLines(container) {
    const PALETTE_SIZE = 5;
    const lines = Array.from(container.querySelectorAll('.tt-section .sui-gurbani-line'))
      .filter((el) => el.textContent.trim().length > 0);
    lines.forEach((el, i) => {
      el.classList.add('gfd-line', `gfd-line-${i % PALETTE_SIZE}`);
    });
  }

  function positionTooltip(tooltip, itemEl) {
    const rect = itemEl.getBoundingClientRect();
    const tRect = tooltip.getBoundingClientRect();

    let left = rect.left;
    const maxLeft = window.innerWidth - tRect.width - 10;
    left = Math.min(Math.max(left, 10), Math.max(10, maxLeft));

    const spaceBelow = window.innerHeight - rect.bottom;
    const spaceAbove = rect.top;
    let top;
    if (spaceBelow >= tRect.height + 10 || spaceBelow >= spaceAbove) {
      top = rect.bottom + 6;
    } else {
      top = rect.top - tRect.height - 6;
    }
    top = Math.min(Math.max(top, 10), Math.max(10, window.innerHeight - tRect.height - 10));

    tooltip.style.left = left + 'px';
    tooltip.style.top = top + 'px';
  }

  function showTooltip(wrapper, itemEl) {
    hideTooltip();

    const gurbaniEl = wrapper.querySelector(GURBANI_DISPLAY_SEL);

    const tooltip = document.createElement('div');
    tooltip.className = 'gurbani-flow-tooltip';

    const toolbar = document.createElement('div');
    toolbar.className = 'tt-toolbar';

    const copyLineBtn = document.createElement('button');
    copyLineBtn.type = 'button';
    copyLineBtn.className = 'tt-copy-btn';
    copyLineBtn.textContent = '📋 Copy Gurbani';
    copyLineBtn.addEventListener('click', async (e) => {
      e.stopPropagation();
      try {
        await copyGurbaniLine(wrapper);
        flashCopied(copyLineBtn);
      } catch (err) {
        console.error('[gurbani-flow] Copy failed', err);
      }
    });

    const copyAllBtn = document.createElement('button');
    copyAllBtn.type = 'button';
    copyAllBtn.className = 'tt-copy-btn tt-copy-btn--secondary';
    copyAllBtn.textContent = '📋 Copy All';
    copyAllBtn.addEventListener('click', async (e) => {
      e.stopPropagation();
      try {
        await copyTooltipAll(wrapper);
        flashCopied(copyAllBtn);
      } catch (err) {
        console.error('[gurbani-flow] Copy failed', err);
      }
    });

    toolbar.appendChild(copyLineBtn);
    toolbar.appendChild(copyAllBtn);
    tooltip.appendChild(toolbar);

    if (gurbaniEl) {
      const g = document.createElement('div');
      g.className = 'tt-gurbani';

      const ancestorContent = document.createElement('div');
      ancestorContent.className = 'sui-shabad-content sui-visraams-colored-words';
      const ancestorBaani = document.createElement('div');
      ancestorBaani.className = 'sui-mixed-view-baani';
      const ancestorWrap = document.createElement('div');
      ancestorWrap.className = 'sui-mixed-view-baani-wrapper';
      const ancestorPara = document.createElement('div');
      ancestorPara.className = 'sui-mixed-view-baani-paragraph';
      const ancestorLine = document.createElement('div');
      ancestorLine.className = 'sui-gurbani-line';

      const ttClone = gurbaniEl.cloneNode(true);
      colorSpecialSymbols(ttClone);

      ancestorLine.appendChild(ttClone);
      ancestorPara.appendChild(ancestorLine);
      ancestorWrap.appendChild(ancestorPara);
      ancestorBaani.appendChild(ancestorWrap);
      ancestorContent.appendChild(ancestorBaani);
      g.appendChild(ancestorContent);

      tooltip.appendChild(g);
    }

    tooltip.appendChild(buildExtraSections(wrapper));
    styleTooltipLines(tooltip);

    document.body.appendChild(tooltip);
    positionTooltip(tooltip, itemEl);

    itemEl.classList.add('gurbani-flow-active');
    activeTooltip = tooltip;
    activeItem = itemEl;
  }

  function relocateToolbar() {
    const navBar = document.querySelector('#nav-bar.header');
    const toolbar = document.querySelector('.shabad-settings');
    if (navBar && toolbar && toolbar.parentElement !== navBar) {
      navBar.appendChild(toolbar);
    }
  }

  function isOwnMutation(mutations) {
    return mutations.every(m => {
      const nodes = [...m.addedNodes, ...m.removedNodes];
      if (nodes.length === 0) return true;
      return nodes.every(n => {
        if (n.nodeType !== 1) return true;
        if (n.classList && (n.classList.contains('gurbani-flow-tooltip') || n.classList.contains('gurbani-flow-container'))) return true;
        if (n.closest && (n.closest('.gurbani-flow-tooltip') || n.closest('.gurbani-flow-container'))) return true;
        return false;
      });
    });
  }

  function stripWordSpacing(gurbaniClone) {
    const leafSpans = Array.from(gurbaniClone.querySelectorAll('span'))
      .filter(s => s.children.length === 0);
    leafSpans.forEach((span, idx) => {
      span.textContent = span.textContent.trim();
      if (idx < leafSpans.length - 1) {
        span.insertAdjacentText('afterend', '\u200B');
      }
    });
    return gurbaniClone;
  }

  function rebuild() {
    if (observer) observer.disconnect();

    document.querySelectorAll('.gurbani-flow-container').forEach(el => el.remove());
    document.querySelectorAll(WRAPPER_SEL).forEach(el => el.classList.remove('gurbani-flow-hidden-original'));
    hideTooltip();
    relocateToolbar();

    const wrappers = Array.from(document.querySelectorAll(WRAPPER_SEL));
    const groups = new Map();
    wrappers.forEach(w => {
      const parent = w.parentElement;
      if (!parent) return;
      if (!groups.has(parent)) groups.set(parent, []);
      groups.get(parent).push(w);
    });

    groups.forEach((list, parent) => {
      const flowContainer = document.createElement('div');
      flowContainer.className = 'gurbani-flow-container';
      parent.insertBefore(flowContainer, list[0]);

      list.forEach(wrapper => {
        const gurbaniEl = wrapper.querySelector(GURBANI_DISPLAY_SEL);
        if (!gurbaniEl) return;

        const containsBrackets = gurbaniEl.textContent.includes('<>');
        const joinedWords = containsBrackets ? getJoinedWords(gurbaniEl) : '';
        const isMoolMantarLine = joinedWords === MOOL_MANTAR_LINE;

        const itemEl = document.createElement('span');
        itemEl.className = 'gurbani-flow-item';
        const flowClone = stripWordSpacing(gurbaniEl.cloneNode(true));

        stripVisraamColors(flowClone);

        if (containsBrackets) {
          itemEl.classList.add('gurbani-flow-red-line');
        } else {
          colorSpecialSymbols(flowClone);
        }

        if (isMoolMantarLine) {
          itemEl.classList.add('gurbani-flow-mool-para');
          scaleFontSize(flowClone, 1.35);
        }

        itemEl.appendChild(flowClone);
        itemEl.appendChild(document.createTextNode(' '));

        itemEl.addEventListener('click', (e) => {
          e.stopPropagation();
          if (activeItem === itemEl) {
            hideTooltip();
          } else {
            showTooltip(wrapper, itemEl);
          }
        });

        flowContainer.appendChild(itemEl);
        wrapper.classList.add('gurbani-flow-hidden-original');
      });
    });

    observer = new MutationObserver(debounce((mutations) => {
      if (isOwnMutation(mutations)) return;
      rebuild();
    }, 300));
    observer.observe(document.body, { childList: true, subtree: true });
  }

  function debounce(fn, ms) {
    let t;
    return function (...args) {
      clearTimeout(t);
      t = setTimeout(() => fn.apply(this, args), ms);
    };
  }

  rebuild();

  document.addEventListener('click', (e) => {
    if (activeTooltip && !activeTooltip.contains(e.target) && !e.target.closest('.gurbani-flow-item')) {
      hideTooltip();
    }
  });
  window.addEventListener('scroll', hideTooltip, { passive: true });

  function isTypingInField(el) {
    if (!el) return false;
    const tag = el.tagName;
    return tag === 'INPUT' || tag === 'TEXTAREA' || el.isContentEditable;
  }

  document.addEventListener('keydown', (e) => {
    if (isTypingInField(document.activeElement)) return;
    if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;

    const label = e.key === 'ArrowLeft' ? 'Previous Ang' : 'Next Ang';
    const btn = document.querySelector(`[aria-label="${label}"]`);
    if (btn) {
      e.preventDefault();
      btn.click();
    }
  });
})();
