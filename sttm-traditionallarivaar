(function () {
  const WRAPPER_SEL = '.sui-mixed-view-baani-wrapper';
  const GURBANI_PARAGRAPH_SEL = '.sui-mixed-view-baani-paragraph';
  const GURBANI_DISPLAY_SEL = '.sui-gurmukhi.sui-gurbani-display';
  const MOOL_MANTAR_LINE = '<>siqnwmukrqwpurKuinrBauinrvYruAkwlmUriqAjUnIsYBMgurpRswid]';

  const STYLE_ID = 'gurbani-flow-style';
  if (!document.getElementById(STYLE_ID)) {
    const style = document.createElement('style');
    style.id = STYLE_ID;
    style.textContent = `
      :root, body, .layout, .shabad-page-layout {
        --sui-sidebar-width: 0px !important;
      }
      html, body {
        overflow-x: hidden !important;
        width: 100vw !important;
        max-width: 100vw !important;
      }
      #app-root, .app-main-content, .layout, .layout__main {
        width: 100vw !important;
        max-width: 100vw !important;
        margin: 0 !important;
      }

      @media (min-width: 1280px) {
        .shabad-page-layout {
          padding-right: 0 !important;
        }
      }

      .shabad-page-content {
        padding: 0 24px 0 12px !important;
      }

      #nav-bar a[aria-label="back to home"],
      .header-section--right,
      .shabad-rail,
      .sui-sidebar,
      .footer {
        display: none !important;
      }

      #metadata.metadata-ang {
        display: none !important;
      }

      .shabad-page-layout,
      .shabad-content-viewer,
      .shabad-container,
      .shabad-content,
      .sui-shabad-content,
      .multi-punjabi-sources,
      .sui-mixed-view-baani {
        max-width: none !important;
        width: 100% !important;
      }

      #nav-bar.header {
        padding-top: 4px !important;
        padding-bottom: 4px !important;
        min-height: 0 !important;
        align-items: center !important;
        display: flex !important;
      }
      .header-search {
        flex: 1 1 auto !important;
      }
      .shabad-settings {
        position: static !important;
        top: auto !important;
        margin-left: 24px !important;
        margin-right: 0 !important;
        margin-bottom: 0 !important;
        padding: 0 !important;
        flex: 0 0 auto !important;
        width: auto !important;
      }
      .shabad-content-viewer {
        margin-top: 0 !important;
        padding-top: 4px !important;
      }

      .gurbani-flow-hidden-original { display: none !important; }

      .gurbani-flow-container {
        display: block;
        line-height: 1.6;
        text-align: justify;
        text-align-last: left;
      }
      .gurbani-flow-item {
        cursor: pointer;
        border-radius: 3px;
        padding: 1px 2px;
      }
      .gurbani-flow-item:hover {
        background: #f0e6c8;
      }
      .gurbani-flow-item.gurbani-flow-active {
        background: #ffe9a8;
      }
      .gurbani-flow-item ${GURBANI_DISPLAY_SEL} {
        display: inline !important;
      }
      .gurbani-flow-item ${GURBANI_DISPLAY_SEL} div {
        display: inline !important;
      }

      /* Any line containing "<>": whole line red, forced onto every
         descendant since the site's own CSS sets an explicit color that
         would otherwise beat simple inheritance. */
      .gurbani-flow-item.gurbani-flow-red-line,
      .gurbani-flow-item.gurbani-flow-red-line * {
        color: #c0392b !important;
      }

      /* Only the exact full Mool Mantar line: its own centered paragraph. */
      .gurbani-flow-item.gurbani-flow-mool-para {
        display: block !important;
        text-align: center !important;
        margin: 16px 0 !important;
      }

      .gurbani-flow-special {
        color: #c0392b;
      }

      .gurbani-flow-tooltip {
        position: fixed;
        max-width: 520px;
        max-height: 70vh;
        overflow-y: auto;
        background: #fff;
        border: 1px solid #ccc;
        box-shadow: 0 4px 14px rgba(0,0,0,0.2);
        padding: 12px 16px;
        border-radius: 6px;
        z-index: 99999;
        font-size: 15px;
        line-height: 1.4;
      }
      .gurbani-flow-tooltip .tt-gurbani {
        margin-bottom: 8px;
      }
      .gurbani-flow-tooltip .tt-gurbani ${GURBANI_DISPLAY_SEL} {
        display: block !important;
      }
      .gurbani-flow-tooltip .tt-gurbani div {
        display: inline !important;
      }
      .gurbani-flow-tooltip .tt-section {
        padding-top: 8px;
        margin-top: 8px;
        border-top: 1px solid #eee;
        color: #333;
      }
      .gurbani-flow-tooltip .tt-section:first-of-type {
        border-top: none;
        margin-top: 0;
        padding-top: 0;
      }
      .gurbani-flow-tooltip .tt-section blockquote {
        margin: 0;
      }
    `;
    document.head.appendChild(style);
  }

  let activeTooltip = null;
  let activeItem = null;
  let observer = null;

  function hideTooltip() {
    if (activeTooltip) activeTooltip.remove();
    if (activeItem) activeItem.classList.remove('gurbani-flow-active');
    activeTooltip = null;
    activeItem = null;
  }

  function colorSpecialSymbols(root) {
    const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);
    const textNodes = [];
    let node;
    while ((node = walker.nextNode())) {
      if (node.nodeValue.includes('<>')) textNodes.push(node);
    }
    textNodes.forEach((textNode) => {
      const parts = textNode.nodeValue.split('<>');
      const frag = document.createDocumentFragment();
      parts.forEach((part, i) => {
        if (part) frag.appendChild(document.createTextNode(part));
        if (i < parts.length - 1) {
          const span = document.createElement('span');
          span.className = 'gurbani-flow-special';
          span.textContent = '<>';
          frag.appendChild(span);
        }
      });
      textNode.parentNode.replaceChild(frag, textNode);
    });
  }

  function scaleFontSize(el, factor) {
    const current = el.style.fontSize;
    const match = current && current.match(/^([\d.]+)([a-z%]+)$/i);
    if (match) {
      const value = parseFloat(match[1]) * factor;
      el.style.fontSize = value + match[2];
    }
  }

  // Joins the trimmed text of every leaf word-span with no separator,
  // giving a clean "spaceless" string to compare against a target line.
  function getJoinedWords(gurbaniEl) {
    const leafSpans = Array.from(gurbaniEl.querySelectorAll('span'))
      .filter(s => s.children.length === 0);
    return leafSpans.map(s => s.textContent.trim()).join('');
  }

  function buildExtraSections(wrapper) {
    const frag = document.createDocumentFragment();
    Array.from(wrapper.children).forEach((child) => {
      if (child.matches(GURBANI_PARAGRAPH_SEL)) return;
      if (!child.textContent.trim()) return;
      const section = document.createElement('div');
      section.className = 'tt-section';
      const clone = child.cloneNode(true);
      colorSpecialSymbols(clone);
      section.appendChild(clone);
      frag.appendChild(section);
    });
    return frag;
  }

  function positionTooltip(tooltip, itemEl) {
    const rect = itemEl.getBoundingClientRect();
    const tRect = tooltip.getBoundingClientRect();

    let left = rect.left;
    const maxLeft = window.innerWidth - tRect.width - 10;
    left = Math.min(Math.max(left, 10), Math.max(10, maxLeft));

    const spaceBelow = window.innerHeight - rect.bottom;
    const spaceAbove = rect.top;
    let top;
    if (spaceBelow >= tRect.height + 10 || spaceBelow >= spaceAbove) {
      top = rect.bottom + 6;
    } else {
      top = rect.top - tRect.height - 6;
    }
    top = Math.min(Math.max(top, 10), Math.max(10, window.innerHeight - tRect.height - 10));

    tooltip.style.left = left + 'px';
    tooltip.style.top = top + 'px';
  }

  function showTooltip(wrapper, itemEl) {
    hideTooltip();

    const gurbaniEl = wrapper.querySelector(GURBANI_DISPLAY_SEL);

    const tooltip = document.createElement('div');
    tooltip.className = 'gurbani-flow-tooltip';

    if (gurbaniEl) {
      const g = document.createElement('div');
      g.className = 'tt-gurbani';
      const ttClone = gurbaniEl.cloneNode(true);
      colorSpecialSymbols(ttClone);
      g.appendChild(ttClone);
      tooltip.appendChild(g);
    }

    tooltip.appendChild(buildExtraSections(wrapper));

    document.body.appendChild(tooltip);
    positionTooltip(tooltip, itemEl);

    itemEl.classList.add('gurbani-flow-active');
    activeTooltip = tooltip;
    activeItem = itemEl;
  }

  function relocateToolbar() {
    const navBar = document.querySelector('#nav-bar.header');
    const toolbar = document.querySelector('.shabad-settings');
    if (navBar && toolbar && toolbar.parentElement !== navBar) {
      navBar.appendChild(toolbar);
    }
  }

  function isOwnMutation(mutations) {
    return mutations.every(m => {
      const nodes = [...m.addedNodes, ...m.removedNodes];
      if (nodes.length === 0) return true;
      return nodes.every(n => {
        if (n.nodeType !== 1) return true;
        if (n.classList && (n.classList.contains('gurbani-flow-tooltip') || n.classList.contains('gurbani-flow-container'))) return true;
        if (n.closest && (n.closest('.gurbani-flow-tooltip') || n.closest('.gurbani-flow-container'))) return true;
        return false;
      });
    });
  }

  function stripWordSpacing(gurbaniClone) {
    const leafSpans = Array.from(gurbaniClone.querySelectorAll('span'))
      .filter(s => s.children.length === 0);
    leafSpans.forEach((span, idx) => {
      span.textContent = span.textContent.trim();
      if (idx < leafSpans.length - 1) {
        span.insertAdjacentText('afterend', '\u200B');
      }
    });
    return gurbaniClone;
  }

  function rebuild() {
    if (observer) observer.disconnect();

    document.querySelectorAll('.gurbani-flow-container').forEach(el => el.remove());
    document.querySelectorAll(WRAPPER_SEL).forEach(el => el.classList.remove('gurbani-flow-hidden-original'));
    hideTooltip();
    relocateToolbar();

    const wrappers = Array.from(document.querySelectorAll(WRAPPER_SEL));
    const groups = new Map();
    wrappers.forEach(w => {
      const parent = w.parentElement;
      if (!parent) return;
      if (!groups.has(parent)) groups.set(parent, []);
      groups.get(parent).push(w);
    });

    groups.forEach((list, parent) => {
      const flowContainer = document.createElement('div');
      flowContainer.className = 'gurbani-flow-container';
      parent.insertBefore(flowContainer, list[0]);

      list.forEach(wrapper => {
        const gurbaniEl = wrapper.querySelector(GURBANI_DISPLAY_SEL);
        if (!gurbaniEl) return;

        const containsBrackets = gurbaniEl.textContent.includes('<>');
        const joinedWords = containsBrackets ? getJoinedWords(gurbaniEl) : '';
        const isMoolMantarLine = joinedWords === MOOL_MANTAR_LINE;

        const itemEl = document.createElement('span');
        itemEl.className = 'gurbani-flow-item';
        const flowClone = stripWordSpacing(gurbaniEl.cloneNode(true));

        if (containsBrackets) {
          itemEl.classList.add('gurbani-flow-red-line');
        } else {
          colorSpecialSymbols(flowClone);
        }

        if (isMoolMantarLine) {
          itemEl.classList.add('gurbani-flow-mool-para');
          scaleFontSize(flowClone, 1.35);
        }

        itemEl.appendChild(flowClone);
        itemEl.appendChild(document.createTextNode(' '));

        itemEl.addEventListener('click', (e) => {
          e.stopPropagation();
          if (activeItem === itemEl) {
            hideTooltip();
          } else {
            showTooltip(wrapper, itemEl);
          }
        });

        flowContainer.appendChild(itemEl);
        wrapper.classList.add('gurbani-flow-hidden-original');
      });
    });

    observer = new MutationObserver(debounce((mutations) => {
      if (isOwnMutation(mutations)) return;
      rebuild();
    }, 300));
    observer.observe(document.body, { childList: true, subtree: true });
  }

  function debounce(fn, ms) {
    let t;
    return function (...args) {
      clearTimeout(t);
      t = setTimeout(() => fn.apply(this, args), ms);
    };
  }

  rebuild();

  document.addEventListener('click', (e) => {
    if (activeTooltip && !activeTooltip.contains(e.target) && !e.target.closest('.gurbani-flow-item')) {
      hideTooltip();
    }
  });
  window.addEventListener('scroll', hideTooltip, { passive: true });

  function isTypingInField(el) {
    if (!el) return false;
    const tag = el.tagName;
    return tag === 'INPUT' || tag === 'TEXTAREA' || el.isContentEditable;
  }

  document.addEventListener('keydown', (e) => {
    if (isTypingInField(document.activeElement)) return;
    if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;

    const label = e.key === 'ArrowLeft' ? 'Previous Ang' : 'Next Ang';
    const btn = document.querySelector(`[aria-label="${label}"]`);
    if (btn) {
      e.preventDefault();
      btn.click();
    }
  });
})();
