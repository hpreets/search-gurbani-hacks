javascript: (function () {

    // ---------- Loading overlay ----------
    function showLoadingOverlay() {
        let overlay = document.querySelector("#sttm-loading-overlay");
        if (overlay) {
            overlay.style.display = "flex";
            return overlay;
        }
        overlay = document.createElement("div");
        overlay.id = "sttm-loading-overlay";
        Object.assign(overlay.style, {
            position: "fixed",
            top: "0",
            left: "0",
            width: "100vw",
            height: "100vh",
            backgroundColor: "#f5f5f5",
            zIndex: "99999",
            display: "flex",
            alignItems: "center",
            justifyContent: "center",
            flexDirection: "column",
            fontFamily: "sans-serif",
        });

        const spinner = document.createElement("div");
        Object.assign(spinner.style, {
            width: "48px",
            height: "48px",
            border: "5px solid #ddd",
            borderTopColor: "#007BFF",
            borderRadius: "50%",
            animation: "sttm-spin 0.8s linear infinite",
            marginBottom: "16px",
        });

        // Keyframes need to be injected once via a style tag
        if (!document.querySelector("#sttm-spin-style")) {
            const styleTag = document.createElement("style");
            styleTag.id = "sttm-spin-style";
            styleTag.textContent = "@keyframes sttm-spin { to { transform: rotate(360deg); } }";
            document.head.appendChild(styleTag);
        }

        const label = document.createElement("div");
        label.innerText = "Loading Ang...";
        label.style.color = "#555";
        label.style.fontSize = "16px";

        overlay.appendChild(spinner);
        overlay.appendChild(label);
        document.body.appendChild(overlay);
        return overlay;
    }

    function hideLoadingOverlay() {
        const overlay = document.querySelector("#sttm-loading-overlay");
        if (overlay) overlay.style.display = "none";
    }

    // ---------- Tuk saving (Shift+Click on a tuk) ----------
    const SAVED_TUKS_KEY = "sttm_saved_tuks";

    function getSavedTuks() {
        try {
            const raw = localStorage.getItem(SAVED_TUKS_KEY);
            return raw ? JSON.parse(raw) : [];
        } catch (err) {
            console.error("sttm: failed to read saved tuks from localStorage", err);
            return [];
        }
    }

    function saveTuk(tukText) {
        if (!tukText) return false;
        try {
            const saved = getSavedTuks();
            // Avoid duplicate entries for the same tuk text.
            if (saved.some((entry) => entry.tukText === tukText)) {
                return "duplicate";
            }
            saved.push({
                tukText: tukText,
                ang: new URL(location.href).searchParams.get("ang"),
                url: location.href,
                savedAt: new Date().toISOString(),
            });
            localStorage.setItem(SAVED_TUKS_KEY, JSON.stringify(saved));
            return true;
        } catch (err) {
            // Most likely a quota error or localStorage disabled.
            console.error("sttm: failed to save tuk", err);
            return false;
        }
    }

    // Brief, self-removing flash so a save is confirmed without adding any
    // persistent UI. Reuses the same wheat highlight already used on hover.
    function flashSaved(el, ok) {
        const original = el.style.backgroundColor;
        el.style.backgroundColor = ok === "duplicate" ? "#ffd54f" : (ok ? "#a5d6a7" : "#ef9a9a");
        setTimeout(() => {
            el.style.backgroundColor = original;
        }, 300);
    }

    // Show overlay immediately, before anything else runs
    showLoadingOverlay();

    // Tuks that should always start a new paragraph, matched exactly against
    // the concatenated Gurmukhi text of the tuk (no spaces, same shape as
    // "completeTuk" below). Add more exact strings here as needed.
    const specialTuks = new Set([
        "ਨਾਨਕਤੇਮੁਖਉਜਲੇਕੇਤੀਛੁਟੀਨਾਲਿ॥੧॥",
        "ਜਿਹਸਿਮਰਤਸੰਕਟਮਿਟੈਦਰਸੁਤੁਹਾਰੋਹੋਇ॥੫੭॥੧॥",
		"ਮਹਲੇਪਹਿਲੇਸਤਾਰਹਅਸਟਪਦੀਆ॥",
    ]);

    function formatPage() {
        document.querySelector("#nav-bar").style.display = "none";
        document.querySelector(".breadcrumb").style.display = "none";
        document.querySelector("#controls-menu").style.display = "none";
        document.querySelector(".pagination-ang").style.display = "none";
        document.querySelector(".footer-background").style.display = "none";
        document.querySelector("#freshworks-container").style.display = "none";
        document.querySelector(".floatingActions").style.display = "none";
		document.querySelector(".review-translations-banner").style.display = "none";
        const contentRoot = document.querySelector("#content-root");
        contentRoot.style.maxWidth = "100%";
        const shabad = document.querySelector("#shabad");
        shabad.style.padding = "64px 10px 5px 10px";
        shabad.style.display = "block";
        shabad.style.lineBreak = "anywhere";
        shabad.style.height = "1500px";
        const topButtonRow = document.querySelector(".shabad-container");
        topButtonRow.style.position = "fixed";
        topButtonRow.style.marginTop = "-15px";
        const topButtonRowNew = document.querySelector("#metadata");
        topButtonRowNew.children[1].children[1].style.display = "none";
        topButtonRowNew.style.padding = "0px";
        topButtonRowNew.style.margin = "0rem 2rem 0rem 2rem";
        topButtonRowNew.style.position = "fixed";
		topButtonRowNew.style.height = "60px";
		document.querySelector('.floatingActionsBottom').style.display = "none";
        let shabadPage = document.querySelector(".shabadPage");
        if (!shabadPage) {
            shabadPage = document.createElement("div");
            shabadPage.classList.add("shabadPage");
            shabadPage.style.padding = "5px 10px 5px 2px";
            shabad.appendChild(shabadPage);
        } else {
            shabadPage.innerHTML = "";
        }
		let tukList = [];
		let countOfIkOankarOnPage = 0;
        document.querySelectorAll(".mixed-view-baani-wrapper").forEach((minViewBaniWrapper) => {
            const newDiv = document.createElement("span");
            let wordsDiv;
            minViewBaniWrapper.querySelectorAll(".unicode").forEach((unicode) => {
                if (unicode.children.length > 0) {
                    let containWords = false;
					let containIkOankar = false;
					let completeTuk = '';
                    wordsDiv = document.createElement("span");
                    wordsDiv.classList.add("tuk");
                    wordsDiv.style.fontFamily = "AnmolUni";
                    wordsDiv.style.fontSize = "40px";
                    wordsDiv.style.paddingTop = "10px";
                    wordsDiv.style.paddingBottom = "5px";
					for (let word of unicode.children) {
						completeTuk += word.textContent.trim();
						// console.log('Inside word.textContent.trim() :::' + word.textContent.trim());
						// console.log('Inside completeTuk :::' + completeTuk);
					}
					console.log('completeTuk :::' + completeTuk);
					if (completeTuk  &&  completeTuk.includes('ੴਸਤਿਨਾਮੁਕਰਤਾਪੁਰਖੁਨਿਰਭਉਨਿਰਵੈਰੁਅਕਾਲਮੂਰਤਿਅਜੂਨੀਸੈਭੰਗੁਰਪ੍ਰਸਾਦਿ')) {
						wordsDiv.style.fontSize = "60px";
						wordsDiv.style.display = "block";
						wordsDiv.style.color = "maroon";
						wordsDiv.style.textAlign = "center";
					}
					else if (completeTuk  &&  completeTuk.includes('ੴ')) {
						wordsDiv.style.color = "maroon";
						// wordsDiv.style.fontWeight = "bold";
					}
					if (document.querySelector('#metadata > div.meta > h4.gurbani-font > a').innerHTML.includes('347')) {
						const body = document.body;
						body.style.backgroundColor = "aliceblue";
					}
					else {
						const body = document.body;
						body.style.backgroundColor = "#f5f5f5";
					}
                    for (let word of unicode.children) {
                        containWords = true;
                        const wordDiv = document.createElement("span");
						wordDiv.textContent = word.textContent.trim();
                        /*if (word.textContent.trim() == "ੴ") {
							countOfIkOankarOnPage++;
							containIkOankar = true;
                            wordDiv.style.fontWeight = "bold";
                            wordDiv.style.color = "crimson";
                        }*/
                        wordsDiv.appendChild(wordDiv);
                    }
                    if (containWords) {
                        newDiv.appendChild(wordsDiv);
                        // Stash the raw concatenated text so the paragraph-break
                        // loop below can exact-match it against specialTuks.
                        newDiv.dataset.tukText = completeTuk;
                    }
                }
            });
            const tooltip = minViewBaniWrapper.cloneNode(true);
            tooltip.style.display = "none";
            tooltip.style.zIndex = 999;
            tooltip.style.position = "absolute";
            tooltip.style.backgroundColor = "#ddd";
            tooltip.style.transform = "translateX(-50%)";
            tooltip.style.left = "50%";
            tooltip.style.width = "1000px";
            tooltip.style.padding = "25px 25px 25px 25px";
            newDiv.appendChild(tooltip);
            minViewBaniWrapper.style.display = "none";
            // shabadPage.appendChild(newDiv);
			
			const viewportWidth = window.innerWidth;
			const viewportHeight = window.innerHeight;

            newDiv.addEventListener("click", function (e) {
				// Shift+Click saves the tuk instead of toggling the tooltip/highlight.
				if (e.ctrlKey) {
					const result = saveTuk(newDiv.dataset.tukText);
					flashSaved(wordsDiv || newDiv, result);
					return;
				}
				if (wordsDiv) {
					if (wordsDiv.style.color != 'red') {
						wordsDiv.style.color = 'red';
					  }
					else {
						wordsDiv.style.color = '#03669b';
					}
				}
                if (newDiv.children[1].style.display == "none") {
                    newDiv.children[1].style.display = "";
                } else {
                    newDiv.children[1].style.display = "none";
                }
				// console.log('mouseclick Y coordinates e.clientY :::' + e.clientY);
				// console.log('tooltip height tooltip.offsetHeight :::' + tooltip.offsetHeight);
				// console.log('tooltip height newDiv.children[1].offsetHeight ::' + newDiv.children[1].offsetHeight);
				// console.log('viewportHeight ::' + viewportHeight);
				if (((e.clientY + 50 + newDiv.children[1].offsetHeight) > viewportHeight)  &&  ((e.clientY - newDiv.children[1].offsetHeight) > 0)) {
					newDiv.children[1].style.top = (e.clientY - 50 - newDiv.children[1].offsetHeight) + 'px';
				}
				else {
					newDiv.children[1].style.top = (e.clientY + 50) + 'px';
				}
				// console.log('newDiv.children[1].style.top :: ' + newDiv.children[1].style.top);
            });
            if (wordsDiv) {
                wordsDiv.addEventListener("mouseenter", function () {
                    wordsDiv.style.backgroundColor = "wheat";
                });
                wordsDiv.addEventListener("mouseleave", function () {
                    wordsDiv.style.backgroundColor = "";
                });
            }
			tukList.push(newDiv);
        });
		
		let lastNewParaAfter = 0;
		for (let i = 0; i < tukList.length; i++) {
		// tukList.forEach((newDiv) => {
			
			let newDiv = tukList[i];
			// console.log(newDiv.textContent);
			// console.log(JSON.stringify(newDiv));
			
			// If ੴ starts without ||<number>||<number>||. For e.g. on Ang 343, 344
			if ((newDiv.innerHTML.includes('ੴ'))  &&  (i > lastNewParaAfter + 3)) {
				shabadPage.appendChild(document.createElement("p"));
				lastNewParaAfter = i;
			}
			
			shabadPage.appendChild(newDiv);

			// If this tuk's text exactly matches one of the configured
			// specialTuks, force a new paragraph AFTER it (not before).
			// Skipped if a paragraph was already started within the last
			// 3 tuks, same guard window used everywhere else below, so a
			// specialTuk immediately following a ੴ break (or vice versa)
			// doesn't produce a spurious extra blank paragraph.
			if ((specialTuks.has(newDiv.dataset.tukText))  &&  (i > lastNewParaAfter + 3)) {
				shabadPage.appendChild(document.createElement("p"));
				lastNewParaAfter = i;
			}

			console.log('tukList[i].dataset.tukText ::' + tukList[i].dataset.tukText);
			// const regex = /\|\|\d+\|\|\d+\|\|/;
			const regex = /॥[੦-੯]+॥[੦-੯]+॥/;
			// Check if current tuk is shabad ending indicated by presence of ||<number>||<number>||
			if (regex.test(newDiv.innerHTML)) {
				console.log('Pattern found!!');

				// If a specialTuks match occurs within the next 3 lines,
				// that match's own after-break (above) is where the
				// paragraph should go — so the ||n||n|| break must NOT
				// fire here, unconditionally.
				let specialTukComingUp = false;
				for (let j = 1; j <= 3; j++) {
					console.log('tukList[i+j].dataset.tukText ::' + tukList[i+j].dataset.tukText);
					if (i+j < tukList.length  &&  specialTuks.has(tukList[i+j].dataset.tukText)) {
						specialTukComingUp = true;
						break;
					}
				}
				console.log('specialTukComingUp ::' + specialTukComingUp);

				if (!specialTukComingUp) {
					let nextUpIkOankar = false;
					// check next 5 tuks to see if ੴ is present in them.
					for (let j = 0; j < 5; j++) {
						if (i+j < tukList.length) {
							nextUpIkOankar = nextUpIkOankar || tukList[i+j].innerHTML.includes('ੴ');
						}
					}

					// if ੴ is present, then add a new line.
					if (nextUpIkOankar  &&  (i > lastNewParaAfter + 3)) {
						shabadPage.appendChild(document.createElement("p"));
						lastNewParaAfter = i;
					}
				}
			}
			
		} // );

        // Formatting is done — safe to reveal the page now
        hideLoadingOverlay();
    }

    formatPage();
    const button = document.createElement("button");
    button.classList.add("formatPageButton");
    button.innerText = "Format Page";
    Object.assign(button.style, {
        position: "fixed",
        top: "10px",
        right: "120px",
        zIndex: "9999",
        padding: "10px 15px",
        backgroundColor: "#007BFF",
        color: "#fff",
        border: "none",
        borderRadius: "5px",
        fontSize: "14px",
        cursor: "pointer",
        boxShadow: "0 4px 6px rgba(0,0,0,0.1)",
    });
    document.body.appendChild(button);
    button.addEventListener("click", function () {
        formatPage();
    });
    document.addEventListener("keydown", function (event) {
        if (event.key === "ArrowRight" || event.key === "k") {
            document.querySelectorAll(".shabad-nav a")[1].click();
        }
        if (event.key === "ArrowLeft" || event.key === "h") {
            document.querySelectorAll(".shabad-nav a")[0].click();
        }
        if (event.key === "j" || event.key === "J") {
            document.querySelector(".formatPageButton").click();
        }
    });
	
	
	
	
	
	
	
	
	
	
	let lastAng = null;
	let running = false;

	function waitForSettled(selector, {
	  settleMs = 1300,
	  timeoutMs = 8000
	} = {}) {
	  return new Promise((resolve, reject) => {
		const start = Date.now();
		let lastCount = -1;
		let lastMutationAt = Date.now();

		const check = () => {
		  const nodes = document.querySelectorAll(selector);
		  const count = nodes.length;

		  if (count > 0 && count === lastCount) {
			// count is stable; if DOM also hasn't changed recently, we're done
			if (Date.now() - lastMutationAt >= settleMs) {
			  obs.disconnect();
			  resolve(nodes);
			}
		  } else {
			lastCount = count;
		  }
		};

		const obs = new MutationObserver(() => {
		  lastMutationAt = Date.now();
		  check();
		});

		obs.observe(document.documentElement, { childList: true, subtree: true, characterData: true });

		// initial check + timeout
		const t = setInterval(() => {
		  check();
		  if (Date.now() - start > timeoutMs) {
			clearInterval(t);
			obs.disconnect();
			reject(new Error(`Timeout waiting for "${selector}" to settle`));
		  }
		}, 50);
	  });
	}

	async function trackAndFormat() {
	  const currentAng = new URL(location.href).searchParams.get("ang");
	  console.log("ang loaded -> formatting:", currentAng, new Date().toISOString());
	  // navigator.sendBeacon('/track', JSON.stringify({ event: 'ang_loaded', ang: currentAng, at: Date.now() }));
	  document.querySelector(".formatPageButton")?.click();
	}

	const observer = new MutationObserver(async () => {
	  const ang = new URL(location.href).searchParams.get("ang");
	  if (!ang || ang === lastAng || running) return;

	  lastAng = ang;
	  running = true;
	  showLoadingOverlay();

	  try {
		await waitForSettled(".mixed-view-baani-wrapper", { settleMs: 500, timeoutMs: 8000 });
		await trackAndFormat();
	  } catch (err) {
		console.error("sttm: failed waiting for page to settle", err);
	  } finally {
		running = false;
		// Safety net: even if formatPage() never ran (e.g. timeout), don't leave the user stuck
		hideLoadingOverlay();
	  }
	});

	observer.observe(document.documentElement, { childList: true, subtree: true });
})();
